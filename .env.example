# Copy this file to .env.local and fill in only the integrations you use.
# Never put real credentials in this example file or commit .env.local.

# Clerk authentication (required for the web app)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Supabase (required for database-backed workflows and full verification)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Model access: configure an OpenAI-compatible endpoint or Anthropic directly.
# Vercel deployments can instead use AI Gateway via their injected OIDC token.
TICKMARK_BASE_URL=
TICKMARK_API_KEY=
TICKMARK_MODEL=
# Set to 1 only when the selected OpenAI-compatible endpoint supports JSON Schema output.
TICKMARK_SUPPORTS_STRUCTURED_OUTPUTS=
TICKMARK_PRICE_IN=
TICKMARK_PRICE_OUT=
ANTHROPIC_API_KEY=

# Optional tracing
NEATLOGS_API_KEY=

# Set to 1 only when intentionally accepting a partial verify:all run without Supabase.
ALLOW_PARTIAL_VERIFY=0
