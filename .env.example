# Copy to .env.local and fill in only the integrations you use.
# Never put real values in this file, and never commit .env.local.
# Nothing here is needed for: npm test, npm run selftest, npm run eval, npm run build.

# ── Auth (Clerk) ── required to sign in: running a close, the exception queue,
# importing books, approving entries, downloading a binder.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Where Clerk sends people to sign in and up; the app serves both routes.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# ── Database (Supabase) ── the system of record. Without it, close reports are
# written to data/ and database-backed pages say so. Server-side only: never
# prefix the service-role key with NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── Model ── resolved in this order:
#   1. TICKMARK_BASE_URL: any OpenAI-compatible endpoint (Ollama, OpenRouter, a gateway)
#      (https://api.openai.com/v1 is routed through OpenAI's own provider)
#   2. ANTHROPIC_API_KEY: the Anthropic API directly
#   3. neither: Vercel AI Gateway, authenticated by the VERCEL_OIDC_TOKEN that
#      `vercel link` / `vercel env pull` writes
TICKMARK_BASE_URL=
TICKMARK_API_KEY=
# The model the endpoint should serve, e.g. llama3.2:latest. Recorded in reports.
TICKMARK_MODEL=
# 1 only if that endpoint and model support JSON Schema structured outputs.
TICKMARK_SUPPORTS_STRUCTURED_OUTPUTS=
ANTHROPIC_API_KEY=

# USD per 1M tokens for a custom endpoint, so cost is priced instead of $0.
# Known Anthropic models are priced from src/lib/agent/pricing.ts.
TICKMARK_PRICE_IN=
TICKMARK_PRICE_OUT=

# Bounds on one generation, so a malformed response cannot stall a close.
TICKMARK_MAX_OUTPUT_TOKENS=4096
TICKMARK_MODEL_TIMEOUT_MS=300000

# ── Access ── 1 lets anyone download a binder without signing in. Only for a
# public demo over synthetic books; never where real books are imported.
TICKMARK_PUBLIC_READ=0

# ── Optional tracing (Neatlogs) ──
NEATLOGS_API_KEY=

# ── Verification ── 1 lets `npm run verify:all` pass while skipping the
# database suites. Leave 0 unless you mean it.
ALLOW_PARTIAL_VERIFY=0
