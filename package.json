{
  "name": "tickmark",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "simulate": "tsx --env-file-if-exists=.env.local scripts/simulate.ts",
    "typecheck": "tsc --noEmit",
    "selftest": "tsx --env-file-if-exists=.env.local scripts/selftest.ts",
    "check": "tsx --env-file-if-exists=.env.local scripts/probe.ts",
    "verify:db": "tsx --env-file-if-exists=.env.local scripts/verify-db.ts",
    "publish": "tsx --env-file-if-exists=.env.local scripts/publish-run.ts",
    "verify:gate": "tsx --env-file-if-exists=.env.local scripts/verify-gate.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.49",
    "@ai-sdk/openai-compatible": "^3.0.44",
    "@ai-sdk/react": "^4.0.96",
    "@clerk/nextjs": "^7.9.1",
    "@supabase/ssr": "^0.12.6",
    "@supabase/supabase-js": "^2.115.0",
    "ai": "^7.0.93",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.41.0",
    "neatlogs": "^1.1.19",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5"
  }
}
